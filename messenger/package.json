{
  "name": "@skyporch/daykeeper-messenger",
  "version": "0.1.1",
  "private": true,
  "description": "Hosted Daykeeper web messenger (IIFE bundle served from the Daykeeper CDN)",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm size",
    "dev": "node scripts/build.mjs && node mock/dev.mjs",
    "e2e": "node scripts/build.mjs && playwright test --project=e2e",
    "release": "node scripts/release.mjs",
    "screenshots": "node scripts/build.mjs && playwright test --project=screenshots",
    "size": "node scripts/size.mjs",
    "test": "node --import tsx --test test/unit/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "22.20.1",
    "axe-core": "4.13.0",
    "esbuild": "0.28.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
